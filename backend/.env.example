# Ayad Network Manager - backend environment template
# Copy to backend/.env on a bare-metal install. Never commit the real .env.

NODE_ENV=production
HOST=0.0.0.0
DASHBOARD_PORT=5000

# The backend serves the built React app directly (no nginx required).
FRONTEND_DIST_PATH=../frontend/dist

# HTTPS certificate used by Fastify in production.
TLS_CERT_PATH=/etc/network-control-system/tls/server.crt
TLS_KEY_PATH=/etc/network-control-system/tls/server.key

# Authentication
ADMIN_USERNAME=admin
# Generate with the deployment installer or with Node scrypt. Do not use plaintext in production.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

# PostgreSQL
DATABASE_URL=postgresql://ayad_nm:CHANGE_ME@127.0.0.1:5432/ayad_nm
DATABASE_USER=ayad_nm
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=ayad_nm
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Network values are intentionally empty on first boot.
# The /setup wizard fills the environment-specific values.
CLIENT_INTERFACE=
UPLINK_INTERFACE=
CLIENT_GATEWAY_IP=
CLIENT_SUBNET=
DHCP_RANGE_START=
DHCP_RANGE_END=
DNS_SERVERS=1.1.1.1,8.8.8.8
SSH_PORT=22
UPLINK_BANDWIDTH_MBPS=100
NETWORK_MODE=single-interface-ifb

# VPN / sing-box defaults. Replace only if your deployment uses different paths.
VPN_TUN_INTERFACE=tun0
VPN_TUN_ADDRESS=172.19.0.1/30
SING_BOX_CONFIG_PATH=/etc/sing-box/config.json
DHCP_RESERVATIONS_PATH=/var/lib/misc/network-control-reservations.conf
DHCP_LEASES_PATH=/var/lib/misc/dnsmasq.leases

# Optional
QUOTA_THROTTLE_MBPS=0.5
NOTIFICATION_WEBHOOK_URL=

# Optional setup path overrides
SYSTEM_CONFIG_PATH=/etc/network-control-system/config.env
DNSMASQ_CONFIG_PATH=/etc/dnsmasq.d/network-control-clients.conf
NFTABLES_CONFIG_PATH=/etc/nftables.d/network-control-system.nft
SETUP_SNAPSHOT_DIR=/var/lib/network-control/backups
