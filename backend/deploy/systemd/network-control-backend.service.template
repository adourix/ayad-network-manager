[Unit]
Description=Network Control System backend
After=network-online.target postgresql.service network-control-enforcement.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_ROOT@
EnvironmentFile=-@APP_ROOT@/.env
EnvironmentFile=-@CONFIG_FILE@
Environment=ENFORCEMENT_SOCKET_PATH=/run/network-control/enforcement.sock
ExecStart=/usr/bin/node @APP_ROOT@/dist/bootstrap.js
Restart=on-failure
RestartSec=5
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@APP_ROOT@ /run/network-control /etc/dnsmasq.d /etc/network-control-system

[Install]
WantedBy=multi-user.target
