# PostgreSQL
POSTGRES_DB=ayad_network_manager
POSTGRES_USER=ayad
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Dashboard
DASHBOARD_PORT=5000
HOST=0.0.0.0

# Installer-owned application settings
# Leave network-specific values to the Setup Wizard on first run.
NODE_ENV=production
DNS_SERVERS=1.1.1.1,8.8.8.8
SSH_PORT=22

# Optional notifications
# NOTIFICATION_WEBHOOK_URL=
