# Ayad Network Manager Docker deployment using PostgreSQL on the Host
DASHBOARD_PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Database must be reachable from the host-networked backend container.
# Installer prompts and writes this connection string.
DATABASE_URL=postgresql://ayad_nm:CHANGE_ME@127.0.0.1:5432/ayad_nm

AUDIT_RETENTION_DAYS=90
SYSTEM_CONFIG_PATH=/etc/network-control-system/config.env
ENFORCEMENT_SOCKET_PATH=/run/network-control/enforcement.sock
ENFORCEMENT_SOCKET_GID=1000
SETUP_SNAPSHOT_DIR=/var/lib/network-control/backups
TLS_CERT_PATH=/etc/network-control-system/tls/server.crt
TLS_KEY_PATH=/etc/network-control-system/tls/server.key

CLIENT_INTERFACE=
UPLINK_INTERFACE=
CLIENT_SUBNET=
CLIENT_GATEWAY_IP=
DHCP_RANGE_START=
DHCP_RANGE_END=
DNS_SERVERS=1.1.1.1,8.8.8.8
SSH_PORT=22
UPLINK_BANDWIDTH_MBPS=
NETWORK_MODE=single-interface-ifb
VPN_TUN_INTERFACE=tun0
