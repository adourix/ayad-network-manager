# Docker deployment environment
POSTGRES_DB=ayad_network_manager
POSTGRES_USER=ayad
POSTGRES_PASSWORD=replace-with-a-long-random-password

DASHBOARD_PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Runtime paths are shared by the backend and the enforcement agent.
SYSTEM_CONFIG_PATH=/etc/network-control-system/config.env
ENFORCEMENT_SOCKET_PATH=/run/network-control/enforcement.sock
# Node runtime group in the official Node image (backend container runs as node).
ENFORCEMENT_SOCKET_GID=1000
SETUP_SNAPSHOT_DIR=/var/lib/network-control/backups
TLS_CERT_PATH=/etc/network-control-system/tls/server.crt
TLS_KEY_PATH=/etc/network-control-system/tls/server.key

# Host network details are persisted by the Setup Wizard; leave unset initially.
CLIENT_INTERFACE=
UPLINK_INTERFACE=
CLIENT_SUBNET=
CLIENT_GATEWAY_IP=
DHCP_RANGE_START=
DHCP_RANGE_END=
DNS_SERVERS=1.1.1.1,8.8.8.8
SSH_PORT=22
UPLINK_BANDWIDTH_MBPS=
NETWORK_MODE=single-interface-ifb
VPN_TUN_INTERFACE=tun0

# Optional integration settings
# NOTIFICATION_WEBHOOK_URL=
