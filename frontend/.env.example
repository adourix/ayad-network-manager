# Optional backend URL for the PWA build. Leave empty to use the gateway's own origin.
# Put the real gateway/server address in .env.production.local (do not commit it).
VITE_API_BASE_URL=https://YOUR-SERVER-HOST:5000

# Vite development proxy target (browser/PWA development only).
VITE_DEV_PROXY_TARGET=https://YOUR-SERVER-HOST:5000
