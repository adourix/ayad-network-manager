# LNCS Router Edition runtime configuration.
# UCI remains authoritative for LAN/WAN/Wi-Fi. These values are derived by the
# onboarding layer and persisted as LNCS runtime settings.
NODE_ENV=production
HOST=0.0.0.0
DASHBOARD_PORT=5000
SYSTEM_CONFIG_PATH=/etc/lncs/router.env
DATABASE_URL=file:/etc/lncs/lncs.db
CLIENT_INTERFACE=
UPLINK_INTERFACE=
CLIENT_GATEWAY_IP=
CLIENT_SUBNET=
DHCP_LEASES_PATH=/tmp/dhcp.leases
NETWORK_MODE=single-interface-ifb
UPLINK_BANDWIDTH_MBPS=0
ENFORCEMENT_SOCKET_PATH=/var/run/network-control/enforcement.sock
VPN_TUN_INTERFACE=
VPN_TUN_ADDRESS=
SING_BOX_CONFIG_PATH=/etc/sing-box/config.json
