#!/bin/sh

# LNCS Router Edition uses OpenWrt's existing network/dhcp configuration.
# Only add the LNCS DHCP hosts file hook; do not replace LAN/WAN UCI config.
uci -q set dhcp.@dnsmasq[0].dhcphostsfile='/etc/lncs/dhcp-reservations.conf'
uci -q commit dhcp

mkdir -p /etc/lncs /var/run/network-control
touch /etc/lncs/dhcp-reservations.conf

/etc/init.d/lncs-db-init enable 2>/dev/null || true
/etc/init.d/lncs-enforcement enable 2>/dev/null || true
/etc/init.d/lncs-backend enable 2>/dev/null || true
chmod 600 /etc/lncs/router.env /etc/lncs/dhcp-reservations.conf 2>/dev/null || true

exit 0
