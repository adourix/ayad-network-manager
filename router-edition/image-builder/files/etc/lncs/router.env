NODE_ENV=production
HOST=0.0.0.0
DASHBOARD_PORT=5000
SYSTEM_CONFIG_PATH=/etc/lncs/router.env
FRONTEND_DIST_PATH=/usr/lib/lncs/frontend/dist
DATABASE_URL=file:/etc/lncs/lncs.db
CLIENT_INTERFACE=
UPLINK_INTERFACE=
CLIENT_GATEWAY_IP=
CLIENT_SUBNET=
DHCP_LEASES_PATH=/tmp/dhcp.leases
DHCP_RESERVATIONS_PATH=/etc/lncs/dhcp-reservations.conf
NETWORK_MODE=single-interface-ifb
UPLINK_BANDWIDTH_MBPS=1000
QUOTA_THROTTLE_MBPS=0.5
ENFORCEMENT_SOCKET_PATH=/var/run/network-control/enforcement.sock
VPN_TUN_INTERFACE=
VPN_TUN_ADDRESS=
SING_BOX_CONFIG_PATH=/etc/sing-box/config.json
SING_BOX_STAGE_PATH=/var/run/network-control/sing-box-config.json
DNS_SERVERS=1.1.1.1,8.8.8.8
