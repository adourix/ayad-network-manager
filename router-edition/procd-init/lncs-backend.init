#!/bin/sh /etc/rc.common

START=96
STOP=09
USE_PROCD=1

PROG="/usr/bin/node"
ENTRY="/usr/lib/lncs/backend/dist/bootstrap.js"
ENV_FILE="/etc/lncs/router.env"

start_service() {
    [ -x "$PROG" ] || return 1
    [ -f "$ENTRY" ] || return 1
    "$PROG" -e 'if (Number(process.versions.node.split(".")[0]) < 22) process.exit(1)' || { logger -t lncs-backend "Node.js 22+ is required"; return 1; }
    . "$ENV_FILE" 2>/dev/null || true

    procd_open_instance "lncs-backend"
    procd_set_param command "$PROG" "$ENTRY"
    procd_set_param env NODE_ENV=production SYSTEM_CONFIG_PATH="$ENV_FILE"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger firewall network
    procd_add_reload_interface_trigger lan
    procd_add_reload_interface_trigger wan
}
